# Puerto local en el que Docker publica la aplicación para nginx.
WEB_PORT=8090

# Región de Amazon SES y direcciones usadas por el formulario de contacto.
AWS_REGION=us-east-1
CONTACT_FROM_EMAIL=contacto@marrso.com
CONTACT_TO_EMAIL=contacto@marrso.com

# Conjunto de configuración de SES para eventos y alertas de correo.
SES_CONFIGURATION_SET=marrso-prod-contact

# Identificadores públicos de analítica y publicidad; deja vacío el proveedor que no uses.
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=

# Token privado de Meta Conversions API para el mismo Pixel; nunca se envía al navegador.
META_CAPI_ACCESS_TOKEN=
# Código opcional de Eventos de prueba de Meta; dejar vacío en producción.
META_CAPI_TEST_EVENT_CODE=
# Credenciales IAM de SES; necesarias solo si el VPS no usa un rol de instancia.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Correo para el registro y las notificaciones de Certbot.
CERTBOT_EMAIL=contacto@marrso.com
